filters:
  and:
    - list(categories).contains(link("Projects"))
    - '!file.name.contains("Template")'
views:
  - type: table
    name: Active
    filters:
      and:
        - status == "active"
    order:
      - file.name
      - areas
      - status
      - created
    sort:
      - property: areas
        direction: ASC
      - property: created
        direction: DESC
      - property: file.mtime
        direction: DESC
  - type: table
    name: All
    order:
      - file.name
      - areas
      - status
      - created
    sort:
      - property: created
        direction: DESC
