filters:
  and:
    - list(categories).contains(link("Transcripts"))
    - '!file.name.contains("Template")'
views:
  - type: table
    name: All Transcripts
    order:
      - file.name
      - people
      - date
      - tags
      - created
    sort:
      - property: created
        direction: DESC
  - type: table
    name: Course
    order:
      - file.name
      - course
      - session
      - session-date
      - people
      - topics
    sort:
      - property: session-date
        direction: DESC
