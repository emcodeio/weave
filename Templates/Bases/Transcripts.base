filters:
  and:
    - list(categories).contains(link("Transcripts"))
    - '!file.name.contains("Template")'
views:
  - type: table
    name: All Transcripts
    order:
      - file.name
      - people
      - date
      - tags
      - created
    sort:
      - property: created
        direction: DESC
  - type: table
    name: Coaching
    filters:
      and:
        - course == "Practice Coaching"
    order:
      - file.name
      - session
      - session-date
      - people
      - created
    sort:
      - property: session-date
        direction: DESC
    columnSize:
      note.session: 89
  - type: table
    name: Meetup
    filters:
      and:
        - course == "eG Meetup"
    order:
      - file.name
      - session-date
      - people
      - topics
      - tags
    sort:
      - property: session-date
        direction: DESC
  - type: table
    name: Course
    filters:
      and:
        - course != "Practice Coaching"
        - course != "eG Meetup"
    order:
      - file.name
      - course
      - session
      - session-date
      - people
      - topics
    sort:
      - property: session-date
        direction: DESC
