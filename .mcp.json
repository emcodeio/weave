{
  "mcpServers": {
    "apple-events": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-apple-events"
      ],
      "env": {}
    },
    "mail": {
      "type": "stdio",
      "command": "apple-mail-mcp",
      "args": ["--watch"],
      "env": {}
    },
    "apple-mail": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "apple-mail-mcp"],
      "env": {}
    },
    "drafts": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@agiletortoise/drafts-mcp-server"],
      "env": {}
    },
    "qmd": {
      "type": "stdio",
      "command": "qmd",
      "args": ["mcp"],
      "env": {}
    }
  }
}
